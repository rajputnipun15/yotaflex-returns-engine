    "disposition_states": "SELECT state,COUNT(*) FROM InventoryDisposition GROUP BY state ORDER BY state",
    "inspection_conditions": "SELECT condition,COUNT(*) FROM Inspection GROUP BY condition ORDER BY condition",
    "movement_units_by_action": "SELECT d.action,SUM(m.quantity) FROM InventoryMovement m JOIN InventoryDisposition d ON d.id=m.disposition_id GROUP BY d.action ORDER BY d.action",
